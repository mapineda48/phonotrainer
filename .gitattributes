# Line endings: text files are stored with LF and checked out with LF on every system,
# whatever core.autocrlf says (Git for Windows defaults it to true). Byte-sensitive checks
# (the didactic-content drift check, the reference exporter, the licence lists) then see
# the same bytes on Windows as on Linux.
* text=auto eol=lf

# Shell scripts must keep LF to run under sh, Git Bash included.
*.sh text eol=lf
gradlew text eol=lf

# Batch files are run by cmd.exe and keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# Committed byte for byte with CRLF (the upstream files as published): never converted.
/android/gradlew.bat -text
/android/core/designsystem/src/main/assets/licenses/charis-OFL.txt -text
/android/design-src/export/assets/licenses/charis-OFL.txt -text
/web/src/assets/fonts/charis/OFL.txt -text

