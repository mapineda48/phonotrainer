    <!-- Help (HelpKey; spec F-01 item 4, F-01-AC5, F-22 "Help"; the web's "About the engines" and pipeline stepper) -->
    <string name="help_title">Help</string>
    <string name="help_lede">Restart the tour, see what the marks mean, and learn how PhonoTrainer works.</string>
    <string name="help_tour">Restart the tour</string>
    <string name="help_tour_body">See the welcome again and every tip once more. Your computer stays connected.</string>
    <string name="help_marks">What do the marks mean?</string>
    <string name="help_marks_body">The line style and the small icon of each kind of change.</string>
    <string name="help_how">How PhonoTrainer works</string>
    <string name="help_how_intro">Your computer does the listening; this phone is where you study. Each link or file you add goes through six steps on your computer.</string>
    <string name="help_step_download">Download</string>
    <string name="help_step_download_body">Fetching the video from the website (links only).</string>
    <string name="help_step_extract">Extract the audio</string>
    <string name="help_step_extract_body">Turning the file into a plain mono recording the models can read.</string>
    <string name="help_step_separate">Separate the dialogue</string>
    <string name="help_step_separate_body">Removing music and effects so that only the voices remain.</string>
    <string name="help_step_transcribe">Transcribe the words</string>
    <string name="help_step_transcribe_body">Whisper writes down every word and when it is said.</string>
    <string name="help_step_phones">Hear the phones</string>
    <string name="help_step_phones_body">The phone recognizer listens to each word and lines it up with its dictionary form.</string>
    <string name="help_step_save">Compare and save</string>
    <string name="help_step_save_body">Labelling what changed in each word and saving the results.</string>
    <string name="help_step_number">Step %1$d of %2$d</string>
    <string name="help_engines">The phone engines</string>
    <string name="help_engines_body">The phone engine listens to the audio and writes down the sounds it hears. Each analysis says which engine produced it, and the figures of different engines are never mixed.</string>
    <string name="help_engine_timit">TIMIT-61 (the default)</string>
    <string name="help_engine_timit_body">A narrow phonetic recognizer: it hears flaps, glottal stops, unreleased stops and weak forms, the changes this app teaches.</string>
    <string name="help_engine_espeak">espeak</string>
    <string name="help_engine_espeak_body">The original engine, trained on dictionary-like transcriptions: it tends to hear the dictionary form instead of what was said.</string>
    <string name="help_phone">On this phone</string>
    <string name="help_phone_body">The finished analysis comes to this phone and becomes shorts: one phrase each, with every change marked. Nothing is analyzed on the phone, and nothing goes to the internet.</string>

