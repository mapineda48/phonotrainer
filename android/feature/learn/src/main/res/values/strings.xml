    <!-- IPA chart (P-09) -->
    <string name="ipa_title">IPA chart</string>
    <string name="ipa_back">Back</string>
    <string name="ipa_lede">Every sound the analyzer can write. Select a symbol to learn how the mouth makes it and to hear it in your own clips.</string>
    <string name="ipa_choose_title">Choose a symbol</string>
    <string name="ipa_choose_body">Each symbol is one sound. Start with [ɾ], [t̚] or [ə].</string>
    <string name="ipa_consonants">Consonants</string>
    <string name="ipa_consonants_lede">Grouped by how the air gets out, then by where the mouth closes. In a pair, the first has no voice and the second has voice.</string>
    <string name="ipa_allophones">Sounds that replace t and d</string>
    <string name="ipa_allophones_lede">American English often says these instead of a full t or d: they are what the analyzer looks for.</string>
    <string name="ipa_syllabics">Syllabic consonants</string>
    <string name="ipa_syllabics_lede">A consonant that makes a whole syllable, with no vowel.</string>
    <string name="ipa_vowels">Vowels</string>
    <string name="ipa_vowels_lede">Grouped by how high the tongue is, then by how far forward. A dotted underline and “weak” mark a weak vowel, the one unstressed syllables reduce to ([ə] is the most frequent).</string>
    <string name="ipa_other">Other symbols</string>
    <string name="ipa_other_lede">Not yet placed in the chart.</string>
    <!-- A place in plain words with its technical term: "Gum ridge · alveolar". -->
    <string name="ipa_place">%1$s · %2$s</string>
    <string name="ipa_weak">weak</string>
