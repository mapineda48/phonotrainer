<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer, API 31+ (architecture 4.1, 20.1): an allowlist of learning progress and settings.
     Never the device queue, file copies, the computer's address, the credential or media. Cloud backup is skipped
     on devices that cannot encrypt it. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="learning.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="learning.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
