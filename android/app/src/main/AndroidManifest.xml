<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Architecture 20.1: the complete list; WorkManager merges WAKE_LOCK and RECEIVE_BOOT_COMPLETED, the modules
         that use the rest declare them (POST_NOTIFICATIONS in :core:notifications, the foreground-service pair in
         :core:sync). Never ACCESS_LOCAL_NETWORK, multicast, Wi-Fi state, location or broad storage. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Backup is an allowlist of learning.db and the settings file (architecture 4.1, 20.1).
         tools:targetApi: enableOnBackInvokedCallback exists from API 33 and dataExtractionRules from 31; older
         versions ignore them and read fullBackupContent instead. -->
    <application
        android:name=".PhonoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Phono"
        tools:targetApi="33">

        <!-- The only launcher entry. singleTask, default affinity (architecture 20.1); the splash theme hands over
             to Theme.Phono (16.5). No orientation lock. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Phono.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Internal targets (architecture 16.4): notifications and the share sheet open MainActivity through this
             alias, which no other app can start. MainActivity honours a target only when it came through here. -->
        <activity-alias
            android:name=".InternalEntry"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- WorkManager is initialised by PhonoApplication with the Hilt worker factory (on demand). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
