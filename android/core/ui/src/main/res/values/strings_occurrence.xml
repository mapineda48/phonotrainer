<?xml version="1.0" encoding="utf-8"?>
<!-- Strings of OccurrenceRow (WP-20; design 9.25): an example from the learner's clips. -->
<resources>
    <!-- The play circle's label; %1$s is the word (or the two linked words). -->
    <string name="occurrence_play">Play “%1$s”</string>
    <string name="occurrence_stop">Stop “%1$s”</string>
    <string name="occurrence_playing">Playing</string>
    <string name="occurrence_stopped">Not playing</string>
    <!-- The row's action, read by TalkBack after the words. -->
    <string name="occurrence_lesson">Open in its lesson</string>
    <!-- A change that runs into the next word: "get it". -->
    <string name="occurrence_words">%1$s %2$s</string>
    <!-- The dictionary form and what was said: "/wɔtɚ/ → [wɔɾɚ]". -->
    <string name="occurrence_forms">%1$s → %2$s</string>
    <!-- The clip and the time of the word in it: "Two friends at the lake · 0:45". -->
    <string name="occurrence_meta">%1$s · %2$s</string>
</resources>
