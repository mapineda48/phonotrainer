.venv/

# Third-party clones kept for reference (see references/NOTES.md). NOT distributed:
# each one has its own license and wav2vec2mdd has none. The pattern also ignores
# loose files, not just directories; NOTES.md is ours and is version-controlled
# separately.
references/*
!references/NOTES.md

out/
out_*/
workspace/
__pycache__/
*.pyc
*.webm
*.mp4
*.mp3
*.wav
.pytest_cache/
*.egg-info/

# UI (React)
node_modules/
web/dist/
web/coverage/
.vite/
*.tsbuildinfo

# generated by the tool (every clone starts clean)
downloads/
data/
*.db

# secrets and local noise (none of it exists yet: the guard comes before the problem)
.env
.env.*
!.env.example
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
